# Copy to .env.local and fill in. Never commit .env.local — it is gitignored.

# Supabase → Project Settings → Data API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Same page. Bypasses RLS — server-only, never expose to a browser.
SUPABASE_SERVICE_ROLE_KEY=

# https://aistudio.google.com/apikey — free tier. Powers the advisor.
# NOT the same as GOOGLE_CLIENT_ID/SECRET below.
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional. Defaults to gemini-3.1-flash-lite.
# The free tier is per-model and small: gemini-3.5-flash allows 20 requests a DAY
# and one advisor conversation costs five or six. It reasons a little more richly,
# so set it here if you are paying for quota. Check a candidate is alive first —
# listing a model is not proof it will answer:
#   curl "https://generativelanguage.googleapis.com/v1beta/models/MODEL:generateContent?key=KEY" \
#     -H 'content-type: application/json' -d '{"contents":[{"parts":[{"text":"hi"}]}]}'
# GEMINI_MODEL=gemini-3.5-flash

# Google Cloud Console → OAuth client. Calendar sync only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

NEXT_PUBLIC_APP_URL=http://localhost:3000
